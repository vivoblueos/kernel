import("//build/templates/rust.gni")

build_rust("loader_test_app") {
  testonly = true
  crate_type = "bin"
  sources = [ "src/main.rs" ]
  deps = [
    "//libc",
    "//librs:librs_swi",
  ]
  configs += [ "//build/boards/${board}:app_config" ]
  rustflags = [
    "-Cpanic=abort",
    "-Crelocation-model=pic",
    "-Clink-arg=-Wl,-static",
    "-Clink-arg=-Wl,-pie",
    "-Clink-arg=-Wl,-no-dynamic-linker",
    "-Clink-arg=-nostartfiles",
  ]

  if (coverage) {
    deps += [ "//kernel/loader:common_cov" ]
    rustflags += [
      "--cfg",
      "coverage",
    ]
  }
}
