import("//build/templates/rust.gni")
import("//build/toolchain/blueos.gni")

build_rust("exec_app") {
  testonly = true
  crate_type = "bin"
  sources = [ "src/main.rs" ]
  configs += [ "//build/boards/${board}:app_config" ]
  linker_script = "link.x"
  rustflags = [
    "-Cpanic=abort",
    "-Crelocation-model=static",
    "-Clink-arg=-Wl,-static",
    "-Clink-arg=-Wl,--no-pie",
    "-Clink-arg=-nostartfiles",
  ]
}

postlink_action("gen_exec_elf_path_symbol") {
  testonly = true
  exe = ":exec_app"
  script = "//kernel/loader/tests/scripts/gen_path_symbol.py"
  outfile = "${target_gen_dir}/${target_name}.c"
  args = [
    "EXEC_ELF_PATH",
    rebase_path(outfile),
  ]
  outputs = [ outfile ]
}

static_library("exec_elf_path") {
  testonly = true
  deps = [ ":gen_exec_elf_path_symbol" ]
  sources = get_target_outputs(":gen_exec_elf_path_symbol")
}
