import("//build/default_targets.gni")
import("//build/templates/board.gni")

blueos_board("qemu_riscv64") {
  kernel_config = {
    cflags = [ "--static" ]
    ldflags = [
      "-nostartfiles",
      "-Wl,-gc-sections",
      "-Wl,-z,norelro",
    ]
    rustflags = [
      "--cfg",
      "target_board=\"qemu_riscv64\"",
      "-Zemit-stack-sizes",
      "-Crelocation-model=static",
      "-Clinker=clang",
      "-Clink-arg=-fuse-ld=lld",
      "-Clink-arg=--target=riscv64",
      "-Clink-arg=-march=rv64",
      "-Clink-arg=-mabi=lp64",
    ]
    foreach(item, ldflags) {
      rustflags += [ "-Clink-arg=${item}" ]
    }
  }

  app_config = {
    rustflags = [
      "--cfg",
      "target_board=\"qemu_riscv64\"",
      "-Clinker=clang",
      "-Clink-arg=-fuse-ld=lld",
      "-Clink-arg=--target=riscv64",
      "-Clink-arg=-march=rv64",
      "-Clink-arg=-mabi=lp64",
      "-Clink-arg=-Wl,-z,norelro",
    ]
  }

  default = []
  _check_all = check_all_on_virtual_board + clippy_all_on_virtual_board
  check_all = filter_exclude(_check_all, [ "//kernel/adapter*" ])
}
