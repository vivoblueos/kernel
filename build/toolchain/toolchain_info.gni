# Single source of truth for toolchain identity and commands.
# Boards select an entry via `board_default_toolchain`.
# BUILDCONFIG.gn derives the global rust context, and
# //build/toolchain/BUILD.gn consumes the commands.

if (host_os == "linux") {
  _host_llvm_target = "x86_64-unknown-linux-gnu"
  _host_target_triple = "x86_64-unknown-linux-gnu"
} else if (host_os == "mac") {
  _host_llvm_target = "aarch64-apple-darwin"
  _host_target_triple = "aarch64-apple-darwin"
}

toolchain_info = {
  host = {
    label = "//build/toolchain:host"
    llvm_target = _host_llvm_target
    target_triple = _host_target_triple
    cc = "clang"
    cxx = "clang++"
    ld = cc
    ar = "llvm-ar"
    objcopy = "llvm-objcopy"
    rustc = "rustc"
    clippy_driver = "clippy-driver"
    current_os = host_os
    current_cpu = host_cpu
  }
  blueos_riscv64 = {
    label = "//build/toolchain:blueos_riscv64"
    llvm_target = "riscv64"
    target_triple = "riscv64-vivo-blueos"
    cc = "clang --target=${llvm_target}"
    cxx = "clang++ --target=${llvm_target}"
    ld = cc
    ar = "llvm-ar"
    objcopy = "llvm-objcopy"
    rustc = "rustc --target=${target_triple}"
    clippy_driver = "clippy-driver --target=${target_triple}"
    current_os = "blueos"
    current_cpu = "riscv64"
  }
  thumbv7m = {
    label = "//build/toolchain:thumbv7m"
    llvm_target = "thumbv7m-none-eabi"
    target_triple = llvm_target
    cc = "clang --target=${llvm_target}"
    cxx = "clang++ --target=${llvm_target}"
    ld = "arm-none-eabi-gcc"
    ar = "llvm-ar"
    objcopy = "llvm-objcopy"
    rustc = "rustc --target=${target_triple}"
    clippy_driver = "clippy-driver --target=${target_triple}"
    current_os = "none"
    current_cpu = "arm"
  }
  blueos_thumbv7m = {
    label = "//build/toolchain:blueos_thumbv7m"
    llvm_target = "thumbv7m-none-eabi"
    target_triple = "thumbv7m-vivo-blueos-newlibeabi"
    cc = "clang --target=${llvm_target}"
