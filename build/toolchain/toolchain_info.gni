    target_triple = "thumbv8m.main-vivo-blueos-newlibeabihf"
    cc = "arm-none-eabi-gcc"
    cxx = "arm-none-eabi-g++"
    ld = cc
    ar = "arm-none-eabi-ar"
    objcopy = "arm-none-eabi-objcopy"
    rustc = "rustc --target=${target_triple}"
    clippy_driver = "clippy-driver --target=${target_triple}"
    current_os = "blueos"
    current_cpu = "arm"
  }
  librs_linux_emulation_thumbv7m = {
    label = "//build/toolchain:librs_linux_emulation_thumbv7m"
    llvm_target = "thumbv7m-vivo-blueos-newlibeabi"
    target_triple = llvm_target
    cc = "arm-none-eabi-gcc"
    cxx = "arm-none-eabi-g++"
    ld = cc
    ar = "arm-none-eabi-ar"
    objcopy = "arm-none-eabi-objcopy"
    rustc = "rustc --target=${target_triple}"
