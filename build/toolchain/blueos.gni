template("blueos_toolchain") {
  toolchain(target_name) {
    # https://groups.google.com/a/chromium.org/g/gn-dev/c/F_lv5T-tNDM
    forward_variables_from(invoker.toolchain_args, "*")
    not_needed("*")
    forward_variables_from(invoker, "*")

    link_map_opt = "-Wl,-Map="
    if (current_os == "mac") {
      link_map_opt = "-Wl,-map,"
    }

    # We support building rust targets with same `crate_name` but different
    # `target_output_name`. For rust lib targets(.rlib, .a, .so), we output
    # artifacts as
    # {{target_output_name}}/lib{{crate_name}}.{{output_extension}}.
    tool("rust_bin") {
      depfile = "{{target_out_dir}}/{{target_output_name}}.d"
      outfile = "{{output_dir}}/{{target_output_name}}"

      if (defined(miri_mode) && miri_mode) {
        clippy_rspfile = "{{target_out_dir}}/{{target_output_name}}.clippy_rsp"
        miri_runner = rebase_path("//build/scripts/miri/run_miri.py")
        command = "{{rustenv}} python3 ${miri_runner} --mode test --miri ${rustc} --sysroot '${miri_sysroot_path}' --stamp ${outfile} --aux-output ${clippy_rspfile} -- --crate-name {{crate_name}} --crate-type {{crate_type}} --emit=dep-info=$depfile,link {{rustflags}} -Copt-level=0 -Cdebuginfo=0 -o ${outfile} {{source}} {{externs}} {{rustdeps}}"
        description = "MIRI ${outfile}"
        outputs = [
          outfile,
          clippy_rspfile,
        ]
      } else {
        mapfile = "{{target_out_dir}}/{{target_output_name}}.map"
        clippy_rspfile = "{{target_out_dir}}/{{target_output_name}}.clippy_rsp"
        binfile = "{{output_dir}}/{{target_output_name}}.bin"

        clippy_command = "{{rustenv}} ${clippy_driver} --crate-name {{crate_name}} --crate-type {{crate_type}} {{rustflags}} ${clippy_lint_flags} {{source}} {{externs}} {{rustdeps}} -o ${outfile}.clippy"

        # Use echo '...' here so that we can keep escape chars, i.e., keep the
        # verbatim clippy_command. Then we can just use the shell to run the
        # `*.clippy_rsp` file.
        gen_clippy_rspfile_command =
            " && echo '${clippy_command}' > ${clippy_rspfile}"

        objcopy_command = "&& $objcopy -O binary ${outfile} ${binfile}"
        rustc_command = "{{rustenv}} ${rustc} --crate-name {{crate_name}} --crate-type {{crate_type}} --emit=dep-info=$depfile,link {{rustflags}} -o ${outfile} {{source}} {{externs}} {{rustdeps}} -Clink-arg=${link_map_opt}${mapfile}"

        command =
            "${rustc_command} ${objcopy_command} ${gen_clippy_rspfile_command}"
        description = "RUST ${outfile}"
        outputs = [
          outfile,
          mapfile,
          binfile,
          clippy_rspfile,
        ]
      }
      default_output_dir = "{{root_out_dir}}/bin"
    }

    tool("rust_dylib") {
      depfile = "{{target_out_dir}}/{{target_output_name}}.d"
      mapfile = "{{target_out_dir}}/{{target_output_name}}.map"
      clippy_rspfile = "{{target_out_dir}}/{{target_output_name}}.clippy_rsp"
      outfile = "{{output_dir}}/lib{{target_output_name}}.so"

      clippy_command = "{{rustenv}} ${clippy_driver} --crate-name {{crate_name}} --crate-type {{crate_type}} {{rustflags}} ${clippy_lint_flags} {{source}} {{externs}} {{rustdeps}} -o ${outfile}.clippy"

      gen_clippy_rspfile_command =
          " && echo '${clippy_command}' > ${clippy_rspfile}"

      rustc_command = "{{rustenv}} ${rustc} --crate-name {{crate_name}} --crate-type {{crate_type}} --emit=dep-info=$depfile,link {{rustflags}} -o ${outfile} {{source}} {{externs}} {{rustdeps}} -Clink-arg=${link_map_opt}${mapfile}"

      command = "${rustc_command} ${gen_clippy_rspfile_command}"
      description = "RUST ${outfile}"
      outputs = [
        outfile,
        mapfile,
        clippy_rspfile,
      ]
      default_output_dir = "{{root_out_dir}}/lib"
    }

    tool("rust_cdylib") {
      depfile = "{{target_out_dir}}/{{target_output_name}}.d"
      mapfile = "{{target_out_dir}}/{{target_output_name}}.map"
      clippy_rspfile = "{{target_out_dir}}/{{target_output_name}}.clippy_rsp"
      outfile = "{{output_dir}}/lib{{target_output_name}}.so"

      clippy_command = "{{rustenv}} ${clippy_driver} --crate-name {{crate_name}} --crate-type {{crate_type}} {{rustflags}} ${clippy_lint_flags} {{source}} {{externs}} {{rustdeps}} -o ${outfile}.clippy"

      gen_clippy_rspfile_command =
          " && echo '${clippy_command}' > ${clippy_rspfile}"

      rustc_command = "{{rustenv}} ${rustc} --crate-name {{crate_name}} --crate-type {{crate_type}} --emit=dep-info=$depfile,link {{rustflags}} -o ${outfile} {{source}} {{externs}} {{rustdeps}} -Clink-arg=${link_map_opt}${mapfile}"

      command = "${rustc_command} ${gen_clippy_rspfile_command}"
      description = "RUST ${outfile}"
      outputs = [
        outfile,
        mapfile,
        clippy_rspfile,
      ]
      default_output_dir = "{{root_out_dir}}/lib"
    }

    tool("rust_staticlib") {
      depfile = "{{target_out_dir}}/{{target_output_name}}/{{crate_name}}.d"
      outfile = "{{target_out_dir}}/{{target_output_name}}/lib{{crate_name}}.a"
      clippy_rspfile = "{{target_out_dir}}/{{target_output_name}}.clippy_rsp"
      clippy_command = "{{rustenv}} ${clippy_driver} --crate-name {{crate_name}} {{source}} --crate-type {{crate_type}} {{rustflags}} ${clippy_lint_flags} {{rustdeps}} {{externs}} -o ${outfile}.clippy"
      gen_clippy_rspfile_command =
          " && echo '${clippy_command}' > ${clippy_rspfile}"
      rustc_command = "{{rustenv}} $rustc --crate-name {{crate_name}} {{source}} --crate-type {{crate_type}} --emit=dep-info=$depfile,link {{rustflags}} -o ${outfile} {{rustdeps}} {{externs}}"
      command = "${rustc_command} ${gen_clippy_rspfile_command}"
      description = "RUST ${outfile}"
      outputs = [
        outfile,
        clippy_rspfile,
      ]
      default_output_dir = "{{root_out_dir}}/lib"
    }

    tool("rust_rlib") {
      depfile = "{{target_out_dir}}/{{target_output_name}}/{{crate_name}}.d"
      outfile =
          "{{target_out_dir}}/{{target_output_name}}/lib{{crate_name}}.rlib"

      if (defined(miri_mode) && miri_mode) {
        clippy_rspfile = "{{target_out_dir}}/{{target_output_name}}.clippy_rsp"
        miri_runner = rebase_path("//build/scripts/miri/run_miri.py")
        command = "{{rustenv}} python3 ${miri_runner} --mode compile --miri ${rustc} --sysroot '${miri_sysroot_path}' --aux-output ${clippy_rspfile} -- --crate-name {{crate_name}} {{source}} --crate-type {{crate_type}} --emit=dep-info=$depfile,link {{rustflags}} -Copt-level=0 -Cdebuginfo=0 -o ${outfile} {{rustdeps}} {{externs}}"
        description = "MIRI RLIB ${outfile}"
        outputs = [
          outfile,
          clippy_rspfile,
        ]
      } else {
        clippy_rspfile = "{{target_out_dir}}/{{target_output_name}}.clippy_rsp"
        clippy_command = "{{rustenv}} ${clippy_driver} --crate-name {{crate_name}} {{source}} --crate-type {{crate_type}} {{rustflags}} ${clippy_lint_flags} {{rustdeps}} {{externs}} -o ${outfile}.clippy"
        rustc_command = "{{rustenv}} $rustc --crate-name {{crate_name}} {{source}} --crate-type {{crate_type}} --emit=dep-info=$depfile,link {{rustflags}} -o ${outfile} {{rustdeps}} {{externs}}"
        gen_clippy_rspfile_command =
            " && echo '${clippy_command}' > ${clippy_rspfile}"
        command = "${rustc_command} ${gen_clippy_rspfile_command}"
        description = "RUST ${outfile}"
        outputs = [
          outfile,
          clippy_rspfile,
        ]
      }
    }

    tool("rust_macro") {
      if (current_os == "ios" || current_os == "mac") {
        default_output_extension = ".dylib"
      } else {
        default_output_extension = ".so"
      }
      depfile = "{{target_out_dir}}/{{crate_name}}.d"
      outfile = "{{target_out_dir}}/lib{{crate_name}}{{output_extension}}"
      clippy_rspfile = "{{target_out_dir}}/{{target_output_name}}.clippy_rsp"
      clippy_command = "{{rustenv}} ${clippy_driver} --crate-name {{crate_name}} {{source}} --crate-type {{crate_type}} {{rustflags}} ${clippy_lint_flags} {{rustdeps}} {{externs}} -o ${outfile}.clippy"
      gen_clippy_rspfile_command =
          " && echo '${clippy_command}' > ${clippy_rspfile}"
      rustc_command = "{{rustenv}} $rustc --crate-name {{crate_name}} {{source}} --crate-type {{crate_type}} --emit=dep-info=$depfile,link {{rustflags}} -o ${outfile} {{rustdeps}} {{externs}}"
      command = "${rustc_command} ${gen_clippy_rspfile_command}"
      description = "RUST ${outfile}"
      outputs = [
        outfile,
        clippy_rspfile,
      ]
    }

    tool("rust_cdylib") {
      if (current_os == "ios" || current_os == "mac") {
        default_output_extension = ".dylib"
      } else {
        default_output_extension = ".so"
      }
      depfile = "{{target_out_dir}}/{{crate_name}}.d"
      outfile = "{{output_dir}}/lib{{crate_name}}{{output_extension}}"
      clippy_rspfile = "{{target_out_dir}}/{{target_output_name}}.clippy_rsp"
      clippy_command = "{{rustenv}} ${clippy_driver} --crate-name {{crate_name}} {{source}} --crate-type {{crate_type}} {{rustflags}} ${clippy_lint_flags} {{rustdeps}} {{externs}} -o ${outfile}.clippy"
      gen_clippy_rspfile_command =
          " && echo '${clippy_command}' > ${clippy_rspfile}"
      rustc_command = "{{rustenv}} $rustc --crate-name {{crate_name}} {{source}} --crate-type {{crate_type}} --emit=dep-info=$depfile,link {{rustflags}} -o ${outfile} {{rustdeps}} {{externs}}"
      command = "${rustc_command} ${gen_clippy_rspfile_command}"
      description = "RUST ${outfile}"
      outputs = [
        outfile,
        clippy_rspfile,
      ]
      default_output_dir = "{{root_out_dir}}/lib"
    }

    tool("asm") {
      depfile = "{{output}}.d"
      command = "$cc -MMD -MF $depfile {{defines}} {{include_dirs}} {{cflags}} {{cflags_c}} -c {{source}} -o {{output}}"
      depsformat = "gcc"
      description = "ASM {{output}}"
      outputs =
          [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.o" ]
    }

    tool("cc") {
      depfile = "{{output}}.d"
      command = "$cc -MMD -MF $depfile {{defines}} {{include_dirs}} {{cflags}} {{cflags_c}} -c {{source}} -o {{output}}"
      depsformat = "gcc"
      description = "CC {{output}}"
      outputs =
          [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.o" ]
    }

    tool("cxx") {
      depfile = "{{output}}.d"
      command = "$cxx -MMD -MF $depfile {{defines}} {{include_dirs}} {{cflags}} {{cflags_cc}} -c {{source}} -o {{output}}"
      depsformat = "gcc"
      description = "CXX {{output}}"
      outputs =
          [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.o" ]
    }

    tool("alink") {
      command = "rm -f {{output}} && $ar rcsD {{arflags}} {{output}} {{inputs}}"
      description = "AR {{output}}"
      outputs = [ "{{output_dir}}/{{target_output_name}}.a" ]
      output_prefix = "lib"
      default_output_dir = "{{root_out_dir}}/lib"
    }

    tool("solink") {
      outfile = "{{output_dir}}/{{target_output_name}}{{output_extension}}"
      if (current_os == "ios" || current_os == "mac") {
        default_output_extension = ".dylib"
        command = "$ld -shared {{ldflags}} -o ${outfile} {{inputs}} {{libs}}"
      } else {
        default_output_extension = ".so"
        command = "$ld -shared {{ldflags}} -Wl,-soname,{{target_output_name}}{{output_extension}} -o ${outfile} {{inputs}} {{libs}}"
      }
      description = "SOLINK ${outfile}"
      outputs = [ outfile ]
      output_prefix = "lib"
      default_output_dir = "{{root_out_dir}}/lib"
    }

    tool("link") {
      out_exe = "{{output_dir}}/{{target_output_name}}"
      out_bin = "{{output_dir}}/{{target_output_name}}.bin"
      out_map = "{{output_dir}}/{{target_output_name}}.map"
      description = "LINK ${out_exe}"
      outputs = [
        out_exe,
        out_bin,
        out_map,
      ]
      objcopy_command = "&& $objcopy -O binary ${out_exe} ${out_bin}"
      if (current_os == "ios" || current_os == "mac") {
        command = "$ld ${link_map_opt}${out_map} {{ldflags}} {{inputs}} {{rlibs}} {{libs}} -o ${out_exe} ${objcopy_command}"
      } else {
        command = "$ld ${link_map_opt}${out_map} {{ldflags}} -Wl,--start-group {{inputs}} {{rlibs}} -Wl,--end-group {{libs}} -o ${out_exe} ${objcopy_command}"
      }
      default_output_dir = "{{root_out_dir}}/bin"
    }

    tool("stamp") {
      command = "touch {{output}}"
      description = "STAMP {{output}}"
    }

    tool("copy") {
      command = "cp -af {{source}} {{output}}"
      description = "COPY {{source}} {{output}}"
    }
  }
}
