blueos_toolchain("host") {
  toolchain_role = "host"
  _info = toolchain_info.host
  llvm_target = _info.llvm_target
  target_triple = _info.target_triple
  cc = _info.cc
  cxx = _info.cxx
  ld = _info.ld
  ar = _info.ar
  objcopy = _info.objcopy
  rustc = _info.rustc
  clippy_driver = _info.clippy_driver

  toolchain_args = {
    current_os = host_os
    current_cpu = host_cpu
  }
}

# Rust dependencies interpreted by Miri must themselves be compiled by the
# matching Miri driver so their rlibs contain complete MIR. This toolchain uses
# the host target and is only entered through miri_test targets.
blueos_toolchain("miri") {
  _info = toolchain_info.host
  llvm_target = _info.llvm_target
  target_triple = host_build_ctx.toolchain_target_triple
  cc = "clang"
  cxx = "clang++"
  ld = cc
  ar = "llvm-ar"
  objcopy = "llvm-objcopy"
  rustc = miri_path
  clippy_driver = "clippy-driver"
  miri_mode = true
  miri_sysroot_path = miri_sysroot
  toolchain_args = {
    current_os = _info.current_os
    current_cpu = _info.current_cpu
  }
}

