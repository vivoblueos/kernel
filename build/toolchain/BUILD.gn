import("//build/toolchain/blueos.gni")
import("//build/toolchain/toolchain_info.gni")

# For consistency, we don't use lld or ld directly. All link processes are
# driven by clang or gcc, even we are using rustc to build executables.
#
# Every field comes from //build/toolchain/toolchain_info.gni.
blueos_toolchain("blueos_riscv64") {
  _info = toolchain_info.blueos_riscv64
  llvm_target = _info.llvm_target
  target_triple = _info.target_triple
  cc = _info.cc
  cxx = _info.cxx
  ld = _info.ld
  ar = _info.ar
  objcopy = _info.objcopy
  rustc = _info.rustc
  clippy_driver = _info.clippy_driver
  toolchain_args = {
    current_os = _info.current_os
    current_cpu = _info.current_cpu
  }
}

