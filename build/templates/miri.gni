import("//build/templates/rust.gni")

# Build and interpret a Rust test through the dedicated Miri toolchain.
#
# The default-toolchain target is a forwarding group. The actual Rust target is
# instantiated under //build/toolchain:miri, so all of its Rust dependencies
# are rebuilt by Miri with complete MIR instead of reusing normal target rlibs.

template("miri_test") {
  if (current_toolchain == default_toolchain) {
    not_needed(invoker, "*")
    group(target_name) {
      testonly = true
      deps = [ ":${target_name}(//build/toolchain:miri)" ]
    }
  } else {
    assert(current_toolchain == "//build/toolchain:miri",
           "miri_test may only use the default or Miri toolchain")

    build_rust(target_name) {
      forward_variables_from(invoker,
                             [
                               "crate_name",
                               "deps",
                               "inputs",
                               "rustenv",
                             ])

      crate_type = "bin"
      testonly = true
      sources = [ invoker.crate ]
      rustflags = [ "--test" ]
      if (defined(invoker.extra_miri_flags)) {
        rustflags += invoker.extra_miri_flags
      }
      if (defined(invoker.configs)) {
        configs += invoker.configs
      }
      if (defined(invoker.public_configs)) {
        public_configs += invoker.public_configs
      }
    }
  }
}
