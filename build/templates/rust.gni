import("//build/config/gnrt_sync.gni")

# This template offers syntactic sugar for rust_library, rust_proc_macro target.
template("build_rust") {
  deps = []

  # Resolve declaration proxies; generated instance labels pass through
  # unchanged.
  if (defined(invoker.deps)) {
    foreach(dep, invoker.deps) {
      _resolved = dep
      foreach(entry, gnrt_crate_index.crates) {
        if (entry.proxy == get_label_info(dep, "label_no_toolchain")) {
          _toolchain = get_label_info(dep, "toolchain")

          # Native apps and proc macros share a toolchain but resolve features
          # separately.
          if (_toolchain == "//build/toolchain:host" &&
              (default_toolchain != "//build/toolchain:host" ||
               (defined(invoker.crate_type) &&
                invoker.crate_type == "proc-macro"))) {
            assert(defined(entry.host_label),
                   "No host recipe for " + entry.proxy + ". Run gnrt sync.")
            _resolved = entry.host_label
          } else {
            assert(defined(entry.target_label),
                   "No target recipe for " + entry.proxy + ". Run gnrt sync.")
            _resolved = entry.target_label
          }
          _resolved += "(" + _toolchain + ")"
        }
      }
      deps += [ _resolved ]
    }
  }

  # Build dependencies use host recipes; action labels pass through unchanged.
  if (defined(invoker.build_deps)) {
    foreach(dep, invoker.build_deps) {
      _resolved = dep
      foreach(entry, gnrt_crate_index.crates) {
        if (entry.proxy == get_label_info(dep, "label_no_toolchain")) {
          assert(defined(entry.host_label),
                 "No host recipe for " + entry.proxy + ". Run gnrt sync.")
          _resolved = entry.host_label + "(//build/toolchain:host)"
        }
      }
      deps += [ _resolved ]
    }
  }

  # Proc macros use host recipes and the host toolchain.
  if (defined(invoker.proc_macro_deps)) {
    foreach(dep, invoker.proc_macro_deps) {
      _resolved = dep
      foreach(entry, gnrt_crate_index.crates) {
        if (entry.proxy == get_label_info(dep, "label_no_toolchain")) {
          assert(defined(entry.host_label),
                 "No host recipe for " + entry.proxy + ". Run gnrt sync.")
          _resolved = entry.host_label + "(//build/toolchain:host)"
        }
      }
      _resolved = get_label_info(_resolved, "label_no_toolchain") +
                  "(//build/toolchain:host)"
      deps += [ _resolved ]
    }
  }

  public_deps = []

  # Explicit public toolchains can export target libraries from a proc macro.
  if (defined(invoker.public_deps)) {
    foreach(dep, invoker.public_deps) {
      _resolved = dep
      foreach(entry, gnrt_crate_index.crates) {
        if (entry.proxy == get_label_info(dep, "label_no_toolchain")) {
          _toolchain = get_label_info(dep, "toolchain")
          if (_toolchain == "//build/toolchain:host" &&
              default_toolchain != "//build/toolchain:host") {
            assert(defined(entry.host_label),
                   "No host recipe for " + entry.proxy + ". Run gnrt sync.")
            _resolved = entry.host_label
          } else {
            assert(defined(entry.target_label),
                   "No target recipe for " + entry.proxy + ". Run gnrt sync.")
            _resolved = entry.target_label
          }
          _resolved += "(" + _toolchain + ")"
        }
      }
      public_deps += [ _resolved ]
    }
  }

  # GN scopes cannot be iterated; pair aliases with the rewritten dependencies.
  if (defined(invoker.aliased_deps)) {
    _alias_file = "$target_gen_dir/${target_name}.cargo_aliases.json"
    _alias_data = {
      aliases = invoker.aliased_deps
      original_deps = []
      if (defined(invoker.deps)) {
        original_deps += invoker.deps
      }
      if (defined(invoker.public_deps)) {
        original_deps += invoker.public_deps
      }
      if (defined(invoker.build_deps)) {
        original_deps += invoker.build_deps
      }
      if (defined(invoker.proc_macro_deps)) {
        original_deps += invoker.proc_macro_deps
      }
      resolved_deps = deps + public_deps
      directory = get_label_info(":" + target_name, "dir")
      toolchain = current_toolchain
    }
    write_file(_alias_file, _alias_data, "json")
    aliased_deps = exec_script("//build/scripts/resolve_cargo_aliases.py",
                               [ rebase_path(_alias_file) ],
                               "json",
                               [ _alias_file ])
  }

  # GN infers `crate_root` from a single `sources` entry, so callers pass the
  # crate root as the only source; the rest come from rustc dep-info.
  forward_variables_from(invoker,
                         [
                           "rustflags",
                           "rustenv",
                           "sources",
                           "inputs",
                           "libs",
                           "lib_dirs",
                           "crate_type",
                           "output_dir",
                           "output_name",
                           "testonly",
                         ],
                         [
                           "configs",
                           "public_configs",
                         ])

  crate_name = target_name
  if (defined(invoker.crate_name)) {
    crate_name = invoker.crate_name
  }
  if (defined(rustenv)) {
    rustenv += [ "CARGO_CRATE_NAME=$crate_name" ]
  } else {
    rustenv = [ "CARGO_CRATE_NAME=$crate_name" ]
  }
  if (defined(rustflags)) {
  } else {
    rustflags = []
  }

  if (defined(board_rustflags)) {
    rustflags += board_rustflags
  }

  if (defined(invoker.features)) {
    foreach(feature, invoker.features) {
      rustflags += [ "--cfg=feature=\"${feature}\"" ]
    }
  }

  if (defined(invoker.cfgs)) {
    foreach(cfg, invoker.cfgs) {
      rustflags += [
        "--cfg",
        cfg,
      ]
    }
  }

  if (defined(invoker.edition)) {
    edition = invoker.edition
    rustflags += [ "--edition=$edition" ]
  } else {
    rustflags += [ "--edition=2021" ]
  }

  rustc_metadata = ""
  if (defined(invoker.rustc_metadata)) {
    rustc_metadata = invoker.rustc_metadata
  } else if (defined(invoker.epoch)) {
    rustc_metadata = "${crate_name}-${invoker.epoch}"
  }

  if (rustc_metadata != "") {
    rustflags += [ "-Cmetadata=${rustc_metadata}" ]
  }

  if (defined(inputs)) {
  } else {
    inputs = []
  }

  if (defined(invoker.linker_script)) {
    rustflags += [ "-Clink-arg=-Wl,-T" + rebase_path(invoker.linker_script) ]
    inputs += [ invoker.linker_script ]
  }

  if (defined(invoker.crate_type) && invoker.crate_type == "proc-macro") {
    rust_proc_macro(target_name) {
      configs = []
      if (defined(invoker.configs)) {
        configs += invoker.configs
      }
      public_configs = []
      if (defined(invoker.public_configs)) {
        public_configs += invoker.public_configs
      }
      all_dependent_configs = []
      if (defined(invoker.all_dependent_configs)) {
        all_dependent_configs += invoker.all_dependent_configs
      }
    }
  } else {
    rust_library(target_name) {
      configs = []
      if (defined(invoker.configs)) {
        configs += invoker.configs
      }
      public_configs = []
      if (defined(invoker.public_configs)) {
        public_configs += invoker.public_configs
      }
      all_dependent_configs = []
      if (defined(invoker.all_dependent_configs)) {
        all_dependent_configs += invoker.all_dependent_configs
      }
    }
  }
}
