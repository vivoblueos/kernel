# Single source of truth for compiler flags. Both `//build/config:${build_type}`
# configs and the `build_config_*` globals read from here.

common_cflags = [
  "-ffunction-sections",
  "-fdata-sections",
]

import("//build/rustc_version.gni")

common_rustflags = [
  "--color=always",

  #FIXME: We should remove these flags in the future.
  "-D",
  "warnings",
  "-A",
  "unused",
  "-A",
  "dead_code",
  "-A",
  "static_mut_refs",
]

if (is_rust_toolchain_older_than_1_90) {
  common_rustflags += [
    "--cfg",
    "compatible_old_toolchain",
  ]
}

build_type_config = {
  debug = {
    rust_profile = "debug"
    cflags = [
               "-O1",
               "-g",
               "-gdwarf-4",
               "-fno-omit-frame-pointer",
               "-fdiagnostics-color=always",
             ] + common_cflags
    cflags_c = [ "-std=c11" ]
    rustflags = [
                  "-Copt-level=1",
                  "-Cforce-frame-pointers=yes",
                  "-Cdebug-assertions",
                  "-Cdebuginfo=full",
                ] + common_rustflags
  }
  release = {
    rust_profile = "release"
    cflags = [
               "-Oz",
               "-fdiagnostics-color=always",

               # There are still a lot of unsafe codes in C or Rust,
               # so switch off strict aliasing currently to avoid subtle bugs.
               "-fno-strict-aliasing",
             ] + common_cflags
    cflags_c = [ "-std=c11" ]
    rustflags = [
                  "-Copt-level=z",
                  "-Cstrip=debuginfo",
                ] + common_rustflags
  }
  coverage = {
    rust_profile = "debug"
    cflags = [
               "-O1",
               "-g",
               "-gdwarf-4",
               "-fno-omit-frame-pointer",
               "-fdiagnostics-color=always",
             ] + common_cflags
    cflags_c = [ "-std=c11" ]
    rustflags = [
                  "-Copt-level=1",
                  "-Cdebuginfo=full",
                  "-Cforce-frame-pointers=yes",
                  "-Cinstrument-coverage",
                  "-Zno-profiler-runtime",
                ] + common_rustflags
  }
  profile = {
    rust_profile = "debug"
    cflags = [
               "-O1",
               "-g",
               "-gdwarf-4",
               "-fno-omit-frame-pointer",
               "-fdiagnostics-color=always",
             ] + common_cflags
    cflags_c = [ "-std=c11" ]
    rustflags = [
                  "-Copt-level=1",
                  "-Cdebuginfo=full",
                  "-Cforce-frame-pointers=yes",
                  "-Cprofile-generate",
                  "-Zno-profiler-runtime",
                ] + common_rustflags
  }
}
