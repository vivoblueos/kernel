# Detect the minor version of the rustc that the build will actually invoke
# (toolchains call rustc by its bare name, i.e. the PATH/rustup default).
#
# Result is a plain integer: 96 for 1.96.0-dev. Evaluated once per `gn gen`.
rustc_minor_version =
    exec_script("//build/scripts/get_rustc_version.py", [], "value", [])

# Global switch: true when the active toolchain is older than 1.90.
# Rust code can branch on it via the `compatible_old_toolchain` cfg, which
# build/config/BUILD.gn sets for every rust target when this is true.
is_rust_toolchain_older_than_1_90 = rustc_minor_version < 90
