# Chip-dependent esp crate declarations. Each chip feature is gated on a GN
# condition so a single declaration serves every esp board: exactly one
# condition holds per build.
cargo_spec("esp-hal") {
  package = "esp-hal"
  version = "=1.1.1"
  default_features = false
  features = [
    {
      condition = "board == \"esp32c6_devkitc_1\""
      values = [ "esp32c6" ]
    },
    {
      condition = "board == \"seeed_xiao_esp32c3\""
      values = [ "esp32c3" ]
    },
  ]
}

