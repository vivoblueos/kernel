# Patch: Accept BlueOS targets and preserve local esp-hal source adaptations.
# Reason: Upstream target checks reject BlueOS triples, and BlueKernel uses
# its own interrupt runtime and HAL integration.

--- a/build.rs
+++ b/build.rs
@@ -39,13 +39,27 @@
     // Ensure that exactly one chip has been specified:
     let chip = esp_metadata_generated::Chip::from_cargo_feature()?;
 
-    if !suppress_panics && chip.target() != std::env::var("TARGET").unwrap_or_default().as_str() {
-        panic!("
+    if !suppress_panics {
+        let target = std::env::var("TARGET").unwrap_or_default();
+        let chip_target = chip.target();
+        // BlueOS uses custom target triples for the same chips, so the upstream
+        // bare-metal target names do not match TARGET.
+        let blueos_target = matches!(
+            (chip.name(), target.as_str()),
+            ("esp32c3", "riscv32imc-vivo-blueos") | ("esp32c6", "riscv32-vivo-blueos")
+        );
+        if chip_target != target.as_str()
+            && !target.is_empty()
+            && !chip_target.starts_with(target.as_str())
+            && !blueos_target
+        {
+            panic!("
         Seems you are building for an unsupported or wrong target (e.g. the host environment).
         Maybe you are missing the `target` in `.cargo/config.toml` or you have configs overriding it?
 
         See https://doc.rust-lang.org/cargo/reference/config.html#hierarchical-structure
         ");
+        }
     }
 
     // Define all necessary configuration symbols for the configured device:
