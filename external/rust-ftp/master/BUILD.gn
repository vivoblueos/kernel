import("//build/boards/${board}.gni")
import("//build/templates/build_template.gni")
import("//build/templates/rust.gni")
import("//build/toolchain/blueos.gni")

build_rust("ftp") {
  epoch = "3"
  crate_type = "rlib"
  sources = [ "src/lib.rs" ]
  edition = "2015"
  deps = [
    "//external/vendor/log-0.4.28:log",
    "//kernel/rsrt:rsrt_std",
    "//librs",
  ]
  features = [
    "debug_print",
    "log",
  ]
  rustflags = [
    "--cap-lints=allow",  # Suppress all warnings in crates.io crates
  ]
  configs += [ "//build/boards/${board}:kernel_config" ]
}

build_rust("example_connecting") {
  crate_name = "example_connecting"
  crate_type = "bin"
  sources = [ "examples/connecting.rs" ]
  deps = [
    ":ftp",
    "//external/vendor/log-0.4.28:log",
    "//kernel/rsrt:rsrt_std",
    "//librs",
  ]
  features = [
    "debug_print",
    "log",
  ]
  linker_script = default_linker_script
  configs += [ "//build/boards/${board}:kernel_config" ]
}
