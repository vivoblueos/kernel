import("//build/templates/build_template.gni")

build_rust("fatfs") {
  crate_type = "rlib"
  sources = [ "src/lib.rs" ]
  edition = "2021"
  deps = [
    "//external/rust:bitflags",
    "//external/rust:log",
  ]
  features = [
    "alloc",
    "log_level_debug",
    "lfn",
  ]
  rustflags = [ "--cap-lints=allow" ]
}
