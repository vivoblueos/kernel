import("//build/templates/cargo_crate.gni")

cargo_crate("esp_rom_sys") {
  epoch = "0.1"
  crate_type = "rlib"
  sources = [ "//external/vendor/esp-rom-sys-0.1.4/src/lib.rs" ]
  inputs = [ "//external/vendor/esp-rom-sys-0.1.4/Cargo.toml" ]
  edition = "2021"
  deps = [ "//external/vendor/cfg-if-1.0.4:cfg_if" ]

  if (board == "esp32c6_devkitc_1") {
    deps += [ "//external/vendor/esp32c6-0.23.0:esp32c6" ]
    features = [ "esp32c6" ]
  } else {
    deps += [ "//external/vendor/esp32c3-0.32.2:esp32c3" ]
    features = [ "esp32c3" ]
  }
  build_deps = [
    "//external/vendor/esp-metadata-generated-0.4.0:esp_metadata_generated",
  ]
  proc_macro_deps =
      [ "//external/vendor/document-features-0.2.12:document_features" ]

  cargo_pkg_name = "esp-rom-sys"
  cargo_pkg_version = "0.1.4"
  build_root = "//external/vendor/esp-rom-sys-0.1.4/build.rs"
  build_sources = [ "//external/vendor/esp-rom-sys-0.1.4/build.rs" ]

  rustflags = [
    "--cap-lints=allow",  # Suppress all warnings in crates.io crates
  ]
}
