import("//build/templates/cargo_crate.gni")

cargo_crate("serde_json") {
  epoch = "1"
  crate_type = "rlib"
  sources = [ "//external/vendor/serde_json-1.0.135/src/lib.rs" ]
  inputs = []
  edition = "2021"
  deps = [
    "//external/vendor/itoa-1.0.18:itoa",
    "//external/vendor/memchr-2.7.6:memchr",
    "//external/vendor/ryu-1.0.23:ryu",
    "//external/vendor/serde-1.0.228:serde",
  ]
  features = [
    "alloc",
    "std",
  ]

  cargo_pkg_name = "serde_json"
  cargo_pkg_version = "1.0.135"
  build_root = "//external/vendor/serde_json-1.0.135/build.rs"
  build_sources = [ "//external/vendor/serde_json-1.0.135/build.rs" ]
  rustenv = [
    "CARGO_CFG_TARGET_ARCH=riscv32",
    "CARGO_CFG_TARGET_POINTER_WIDTH=32",
  ]

  rustflags = [ "--cap-lints=allow" ]
}
