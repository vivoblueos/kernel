import("//build/templates/cargo_crate.gni")

cargo_crate("esp_radio_rtos_driver") {
  epoch = "0.3"
  crate_type = "rlib"
  sources = [ "//external/vendor/esp-radio-rtos-driver-0.3.0/src/lib.rs" ]
  inputs = []
  edition = "2021"
  deps = [
    "//external/vendor/cfg-if-1.0.4:cfg_if",
    "//external/vendor/esp-sync-0.2.1:esp_sync",
    "//external/vendor/portable-atomic-1.13.1:portable_atomic",
  ]

  if (board == "esp32c6_devkitc_1") {
    features = [
      "esp32c6",
      "ipc-implementations",
    ]
  } else {
    features = [
      "esp32c3",
      "ipc-implementations",
    ]
  }

  cargo_pkg_name = "esp-radio-rtos-driver"
  cargo_pkg_version = "0.3.0"

  rustflags = [
    "--cap-lints=allow",  # Suppress all warnings in crates.io crates
  ]
}
