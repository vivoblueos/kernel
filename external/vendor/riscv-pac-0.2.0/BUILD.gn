import("//build/templates/cargo_crate.gni")

cargo_crate("riscv_pac") {
  epoch = "0"
  crate_type = "rlib"
  sources = [ "//external/vendor/riscv-pac-0.2.0/src/lib.rs" ]
  inputs = []
  edition = "2021"

  cargo_pkg_name = "riscv-pac"
  cargo_pkg_version = "0.2.0"

  rustflags = [
    "--cap-lints=allow",  # Suppress all warnings in crates.io crates
  ]
}
