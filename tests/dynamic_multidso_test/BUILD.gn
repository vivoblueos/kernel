import("//build/boards/${board}.gni")
import("//build/templates/build_template.gni")
import("//build/toolchain/blueos.gni")

# end-to-end test: the manifest-closed multi-DSO package (root + foo/bar/common
# private DSOs + the shared libc) is embedded by the boot seed blobs and seeded
# into the root tmpfs; the test launches /apps/multi/app.elf twice through the
# full ApplicationService path and the checker counts the diagnostic lines: each
# private identity maps exactly once per group (the foo/bar diamond hits
# libcommon twice but loads it once), and each group's exit
# releases all four private allocations in exactly one reap.

build_rust("dynamic_multidso_test") {
  testonly = true
  crate_type = "bin"
  edition = "2021"
  sources = [ "src/test.rs" ]
  deps = [
    "//external/vendor/semihosting-0.1.20:semihosting",
    "//kernel/kernel:blueos",
    "//kernel/loader:blueos_loader",
    "//kernel/rsrt",
    "//libc",
    "//librs",
  ]
  linker_script = default_linker_script
  proc_macro_deps = [ "//kernel/test_harness:blueos_test_macro" ]
  rustflags = [ "--test" ]
}

gen_qemu_runner("dynamic_multidso_test_runner") {
  testonly = true
  img = ":dynamic_multidso_test"
  qemu = qemu_exe
  machine = qemu_machine
  semihosting = true
  qemu_args = qemu_extra_args
  block_img = "dynamic_multidso_test_block.img"
  block_args = qemu_block_args
}

run_qemu_check("run_dynamic_multidso_test") {
  testonly = true
  runner = ":dynamic_multidso_test_runner"
  checker = "src/test.rs"
}
