import("//build/boards/${board}.gni")
import("//build/templates/build_template.gni")
import("//build/toolchain/blueos.gni")

# scope/visibility end-to-end test: launches the scope corpus package —
# weak/strong/hidden/protected private DSOs, an app that interposes private
# defaults, a second system DSO that must not be interposed, SysV and GNU hash
# artifacts and an undefined weak data reference — and asserts both the
# runtime
# bindings and the SCOPE_BIND diagnostic triples.

build_rust("dynamic_scope_test") {
  testonly = true
  crate_type = "bin"
  edition = "2021"
  sources = [ "src/test.rs" ]
  deps = [
    "//external/vendor/semihosting-0.1.20:semihosting",
    "//kernel/kernel:blueos",
    "//kernel/loader:blueos_loader",
    "//kernel/rsrt",
    "//libc",
    "//librs",
  ]
  linker_script = default_linker_script
  proc_macro_deps = [ "//kernel/test_harness:blueos_test_macro" ]
  rustflags = [ "--test" ]
}

gen_qemu_runner("dynamic_scope_test_runner") {
  testonly = true
  img = ":dynamic_scope_test"
  qemu = qemu_exe
  machine = qemu_machine
  semihosting = true
  qemu_args = qemu_extra_args
  block_img = "dynamic_scope_test_block.img"
  block_args = qemu_block_args
}

run_qemu_check("run_dynamic_scope_test") {
  testonly = true
  runner = ":dynamic_scope_test_runner"
  checker = "src/test.rs"
}
