import("//build/boards/${board}.gni")
import("//build/templates/rust.gni")
import("//build/toolchain/blueos.gni")

build_rust("net_example") {
  crate_name = "net_example"
  crate_type = "bin"

  sources = [ "src/main.rs" ]
  deps = [
    "//kernel/rsrt:rsrt_std",
    "//librs",
  ]
  linker_script = default_linker_script
  configs += [ "//build/boards/${board}:kernel_config" ]
}

# The example connects to an external server, so the check only covers the
# local path: virtio-net probe, network stack init and socket creation. It
# deliberately stops before the payload exchange, which needs a reachable peer.
gen_qemu_runner("net_example_runner") {
  img = ":net_example"
  qemu = "$qemu_exe"
  machine = "$qemu_machine"
  qemu_args = qemu_extra_args
  net_args = qemu_net_args
  block_img = "net_example_block.img"
  block_args = qemu_block_args
}

run_qemu_check("run_net_example") {
  testonly = true
  runner = ":net_example_runner"
  checker = "//kernel/kernel/tests/net.checker"
}
