import("//build/boards/${board}.gni")
import("//build/templates/rust.gni")
import("//build/toolchain/blueos.gni")

# Measurement workload behind report/baseline.json. It is not part of
# check_all: the collector (tools/baseline.py) builds and runs it once per
# syscall mode.
build_rust("bench") {
  crate_name = "bench"
  crate_type = "bin"
  sources = [ "src/main.rs" ]
  deps = [
    "//kernel/header:blueos_header",
    "//kernel/rsrt:rsrt_std",
    "//kernel/scal:blueos_scal",
    "//libc",
    "//librs",
  ]
  linker_script = default_linker_script
  configs += [ "//build/boards/${board}:kernel_config" ]
}

gen_qemu_runner("bench_runner") {
  img = ":bench"
  qemu = "$qemu_exe"
  machine = "$qemu_machine"
  qemu_args = qemu_extra_args
  net_args = qemu_net_args
  block_img = "bench_block.img"
  block_args = qemu_block_args
}
