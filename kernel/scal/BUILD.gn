import("//build/templates/rust.gni")
import("features.gni")

if (syscall_mode == "linux_abi") {
  action("gen_linux_syscalls") {
    script = "//build/scripts/gen_linux_syscalls.py"
    inputs = [ script ]
    outputs = [
      "$target_gen_dir/linux_syscalls/aarch64.rs",
      "$target_gen_dir/linux_syscalls/riscv64.rs",
    ]
    args = [
      "--output-dir",
      rebase_path("$target_gen_dir/linux_syscalls", root_build_dir),
    ]
  }

  _linux_gen_dir = get_label_info(":gen_linux_syscalls", "target_gen_dir")
  _linux_root = "$_linux_gen_dir/linux_syscalls/lib.rs"
  _linux_arch = board_toolchain_info.current_cpu
  write_file(_linux_root,
             [
               "#![no_std]",
               "pub mod ${_linux_arch};",
               "pub use ${_linux_arch}::*;",
             ])

  build_rust("linux_syscalls") {
    crate_name = "linux_syscalls"
    crate_type = "rlib"
    edition = "2024"
    sources = [ _linux_root ]
    build_deps = [ ":gen_linux_syscalls" ]
  }
}

build_rust("blueos_scal") {
  crate_name = "blueos_scal"
  crate_type = "rlib"
  sources = [ "src/lib.rs" ]
  edition = "2024"
  deps = [ "//kernel/header:blueos_header" ]
  configs += [ "//build/boards/${board}:kernel_config" ]
  cfgs = [ syscall_mode_cfg ]
  if (syscall_mode == "linux_abi") {
    build_deps = [ ":gen_linux_syscalls" ]
  }
  if (syscall_mode == "dsc") {
    deps += [ "//kernel/kernel:blueos" ]
  }
}

build_rust("blueos_scal_swi") {
  crate_name = "blueos_scal"
  crate_type = "rlib"
  sources = [ "src/lib.rs" ]
  edition = "2024"
  deps = [ "//kernel/header:blueos_header" ]
  configs += [ "//build/boards/${board}:kernel_config" ]
  if (syscall_mode == "linux_abi") {
    cfgs = [ syscall_mode_cfg ]
  } else {
    cfgs = [ "syscall_mode=\"swi\"" ]
  }
}
