# Memory allocation algorithm configuration

choice
    prompt "Memory allocation algorithm"
    default ALLOCATOR_TLSF
    config ALLOCATOR_TLSF
        bool "TLSF algorithm"
    config ALLOCATOR_SLAB
        bool "SLAB algorithm (static)"
    config ALLOCATOR_SLAB_DYNAMIC
        bool "SLAB algorithm (dynamic, with page pool)"
    config ALLOCATOR_LLFF
        bool "LLFF algorithm"
endchoice

config ALLOCATOR
    string
    default "tlsf" if ALLOCATOR_TLSF
    default "slab" if ALLOCATOR_SLAB
    default "slab_dynamic" if ALLOCATOR_SLAB_DYNAMIC
    default "llff" if ALLOCATOR_LLFF

config SLAB_DEBUG
    bool "Enable SLAB allocator debug logging"
    default n
    depends on ALLOCATOR_SLAB || ALLOCATOR_SLAB_DYNAMIC
    help
      Enable debug logging for SLAB allocator operations including
      page allocation, deallocation, and pool management.

config SLAB_DYNAMIC_MAX_TOTAL_PAGES
    int "Max total pages in page pool"
    default 32
    depends on ALLOCATOR_SLAB_DYNAMIC

config ALLOCATOR_BUDDY
    bool "Use buddy allocator as dynamic slab backing allocator"
    depends on ALLOCATOR_SLAB_DYNAMIC
    default n
    help
        Use the buddy allocator to manage allocatable physical pages and
        serve as the backing allocator for dynamic slab.

        Dynamic slab obtains slab pages from buddy. Requests that cannot be
        served by a slab size class, including requests larger than 2048 bytes
        or requiring larger alignment, are forwarded to buddy.

        When disabled, dynamic slab uses TLSF as its backing allocator over
        the __heap_start to __heap_end range.

config BUDDY_MAX_ORDER
    int "Maximum buddy allocation order" if ALLOCATOR_BUDDY
    range 0 19
    default 11
    help
        Set the largest allocation order supported by the buddy allocator.
        An order-N allocation contains 2^N pages. With 4 KiB pages, the
        default order 11 supports allocations up to 8 MiB.
