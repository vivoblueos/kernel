msgstr ""

#: src/how-to-use-blueos-repo.md:281
msgid "Excluded central baseline; paired with `--target-base`."
msgstr ""

#: src/how-to-use-blueos-repo.md:282
msgid "`--source-rev`"
msgstr ""

#: src/how-to-use-blueos-repo.md:282
msgid "Required final central commit; included in the range."
msgstr ""

#: src/how-to-use-blueos-repo.md:283
msgid "Component name; uses the merge script's directory mapping."
msgstr ""

#: src/how-to-use-blueos-repo.md:284
msgid "`--target-remote`"
msgstr ""

#: src/how-to-use-blueos-repo.md:284
msgid "Configured target Josh remote name."
msgstr ""

